# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@192.168.1.13:5432/tiket_konser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tiket_konser

# Redis Cache & Queue
REDIS_URL=redis://:redispassword@192.168.1.13:6379
REDIS_HOST=192.168.1.13
REDIS_PORT=6379
